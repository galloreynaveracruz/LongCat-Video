  "structures": [
    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno (?:es|son) (?:s[oó]lo|solamente|[uú]nicamente) [^.!?\\n]{2,60}[,.;] (?:es|son|sino)\\b",
      "name": "\"No es solo X, es Y\"",
      "fix": "Di la única cosa que de verdad quieres decir. Borra la mitad que prepara."
    },
    {
      "id": "no-es-x-es-y",
      "regex": "(?i)\\bno (?:es|son) (?:un|una|el|la|los|las) [^.!?\\n,]{2,40}, (?:es|son) (?:un|una|el|la|los|las)\\b",
      "name": "\"No es X, es Y\" (contraste de frase hecha)",
      "fix": "Quita la mitad negada y di la afirmación con un dato propio."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno s[oó]lo\\b[^.!?\\n]{2,80}\\bsino (?:tambi[eé]n|que)\\b",
      "name": "\"No solo X, sino también Y\"",
      "fix": "Pártelo en dos oraciones o quita la mitad más débil."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata (?:s[oó]lo )?de [^.!?\\n]{2,60}[.,;!] (?:se trata de|es)\\b",
      "name": "\"No se trata de X. Se trata de Y.\"",
      "fix": "Empieza por Y. La vuelta de tuerca es la señal."
    },
    {
      "id": "el-resultado",
      "regex": "(?im)^\\s*¿?(?:el resultado|lo mejor|lo mejor de todo|el truco|el secreto|la clave|la trampa)\\?\\s*$",
      "name": "Pregunta retórica de una línea (\"¿El resultado?\")",
      "fix": "Contéstala en la misma oración en vez de montar una revelación."
    },
    {
      "id": "lo-que-aprendi",
      "regex": "(?i)\\b(?:esto es lo que aprend[ií]|te cuento lo que aprend[ií]|lo que aprend[ií] fue)\\b",
      "name": "\"Esto es lo que aprendí\"",
      "fix": "Di la lección. Sáltate el anuncio."
    },
    {
      "id": "triada",
      "regex": "(?i)\\b\\w+, \\w+ (?:y|e) \\w+[.!]",
      "name": "Tríada (regla de tres)",
      "fix": "Dos elementos o cuatro. Tres es el ritmo por defecto del modelo."
    },
    {
      "id": "cohete",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de cohete / fuego / foco / brillos / diana",
      "fix": "Un emoji como máximo, y que no sea uno de estos cinco."
    },
    {
      "id": "muro-hashtags",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Muro de hashtags (6+)",
      "fix": "Instagram limita a 5 hashtags por publicación desde diciembre de 2025. Usa de 3 a 5 que de verdad describan el post."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial)\\b|\\bcomo (?:un )?modelo de lenguaje\\b",
      "name": "El modelo hablando de sí mismo",
      "fix": "Borra la oración."
    },
    {
      "id": "en-resumen",
      "regex": "(?im)^\\s*(?:en resumen|en conclusi[oó]n|para concluir|para resumir|en definitiva)\\b",
      "name": "Apertura de cierre de ensayo",
      "fix": "Un post no necesita párrafo de conclusión."
    },
    {
      "id": "carnada-comentarios",
      "regex": "(?im)(?:¿?\\s*(?:est[aá]s de acuerdo|qu[eé] opinas|t[uú] qu[eé] opinas|me equivoco|qui[eé]n m[aá]s)\\s*\\?)\\s*$",
      "name": "Carnada de comentarios por reflejo",
      "fix": "Haz una pregunta que solo tú podrías hacer, sobre lo concreto que acabas de decir."
    },
    {
      "id": "deja-scroll",
      "regex": "(?im)^\\s*¡?\\s*(?:deja de (?:hacer scroll|scrollear|deslizar)|no hagas scroll|no sigas bajando|espera,? no (?:hagas scroll|te vayas|deslices))",
      "name": "Apertura \"Deja de hacer scroll\"",
      "fix": "Lo que detiene el scroll tiene que ser la afirmación misma. Pedir atención delata que no te la ganaste."
    },
    {
      "id": "en-este-video",
      "regex": "(?i)\\b(?:en (?:este|el) (?:v[ií]deo|reel|post) de hoy|en este (?:v[ií]deo|reel|post)|hoy te voy a (?:enseñar|mostrar|explicar)|te voy a (?:enseñar|mostrar) c[oó]mo)\\b",
      "name": "Preámbulo de video (\"en este video te voy a enseñar\")",
      "fix": "Bórralo y empieza en el resultado. Los primeros dos segundos deciden todo el Reel."
    },
    {
      "id": "vinetas-emoji",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨👉]\\s*\\S",
      "name": "Lista con viñetas de emoji",
      "fix": "Usa guion o salto de línea. Las viñetas de emoji son lo más de plantilla que puede tener un caption."
    },
    {
      "id": "gritos",
      "regex": "\\b[A-ZÁÉÍÓÚÜÑ]{3,}\\b(?:\\s+\\b[A-ZÁÉÍÓÚÜÑ]{3,}\\b){2,}",
      "name": "Tres o más palabras gritadas seguidas",
      "fix": "Las mayúsculas son volumen, no marcatextos. Una palabra, máximo."
    },
    {
      "id": "carnada-follow",
      "regex": "(?i)(?:s[ií]gueme para m[aá]s|etiqueta a (?:alguien|ese amig[oa]|tu amig[oa])|dale (?:doble tap|like) si|comparte (?:esto|este post) (?:si|con)|comenta (?:abajo )?si|guarda (?:este|esta) (?:post|publicaci[oó]n|reel))",
      "name": "Carnada de follow, etiqueta o guardado",
      "fix": "Pide la única acción que este post se gana. La petición genérica enseña a tu audiencia a ignorar todas."
    },
    {
      "id": "sabias-que",
      "regex": "(?im)^\\s*¿\\s*sab[ií]as que\\b",
      "name": "Apertura \"¿Sabías que...?\"",
      "fix": "Di el dato directo. La pregunta de trivia es el gancho de plantilla más gastado en español."
    }
  ]
